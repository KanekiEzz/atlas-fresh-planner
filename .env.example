# Atlas Fresh Planning Assistant Configuration
# Configure Ollama as the local AI provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
# OLLAMA_TIMEOUT: seconds to wait for model response.
# Ollama cold-load (first request after idle) measured at ~30s on this machine.
# 120s gives safe headroom for cold-start while keeping a finite upper bound.
OLLAMA_TIMEOUT=120.0

# Optional server configuration
PORT=8080
